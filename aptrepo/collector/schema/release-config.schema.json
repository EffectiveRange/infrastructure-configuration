    "type": "object",
    "properties": {
      "owner": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "matcher": {
        "type": "string"
      },
      "component": {
        "type": "string"
      },
      "private": {
        "type": "boolean"
      },
      "tag": {
        "type": "string"
      },
      "token": {
